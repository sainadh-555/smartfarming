# SmartFarm AI — Backend Environment Variables for Render Deployment
# Set these in your Render Dashboard: Service -> Environment -> Add Environment Variable

# 1. Google Gemini API Key (Recommended - Free at https://aistudio.google.com/app/apikey)
# Enables Gemini 1.5 Flash Vision for Plant Disease Inference
GEMINI_API_KEY=

# 2. Groq Cloud API Key (Free at https://console.groq.com/keys)
# Enables Llama 3.2 11B Vision Preview for Plant Disease Inference
GROQ_API_KEY=

# 3. OpenAI API Key (Optional from https://platform.openai.com/api-keys)
# Enables GPT-4o-mini Vision
OPENAI_API_KEY=

# 4. Port (Set automatically by Render)
PORT=8000

