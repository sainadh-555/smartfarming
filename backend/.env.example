# SmartFarm AI — Backend Environment Variables for Render Deployment
# Set these in your Render Dashboard: Service -> Environment -> Add Environment Variable

# ==============================================================
# 1. AI Vision Inference Configuration (Section D)
# ==============================================================
# Dedicated Vision Key & Provider (or use GEMINI_API_KEY / GROQ_API_KEY below)
AI_VISION_API_KEY=
AI_VISION_PROVIDER=gemini
AI_VISION_MODEL=gemini-1.5-flash

# ==============================================================
# 2. Named AI Keys (Automatic Provider Resolution)
# ==============================================================
# Google Gemini API Key (Recommended - Free at https://aistudio.google.com/app/apikey)
# Enables Gemini 1.5 Flash Multimodal Vision & Copilot
GEMINI_API_KEY=

# Groq Cloud API Key (Free at https://console.groq.com/keys)
# Enables Qwen 3.8 27B Vision (qwen/qwen3.8-27b) & Llama 3.3 70B Copilot
GROQ_API_KEY=

# OpenAI API Key (Optional from https://platform.openai.com/api-keys)
# Enables GPT-4o-mini Vision & Copilot
OPENAI_API_KEY=

# ==============================================================
# 3. Persistent Database Storage
# ==============================================================
# PostgreSQL Connection URL (e.g. postgresql://user:pass@host/dbname)
# Automatically populated if you attach a Render PostgreSQL database.
# Defaults to local SQLite (smartfarm.db) if omitted.
DATABASE_URL=

# ==============================================================
# 4. Server Configuration
# ==============================================================
PORT=8000


