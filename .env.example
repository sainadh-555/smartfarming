# SmartFarm AI — Optional LLM Cloud API Keys
# You can enter these keys directly in the website UI (under AI Settings),
# or provide them here in your local .env file.

# Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=
